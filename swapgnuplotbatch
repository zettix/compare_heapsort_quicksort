set title 'Swaps Comparison Between Heapsort and Quicksort '
set terminal png large size 1024,768
set output 'swap_comparison_heap_quick.png'
set grid
show grid
set xlabel "UNSORTED COUNT"
set ylabel "SWAPS"
plot 'swapstats' u 1:2 w lines lw 1 t 'Heapsort', 'swapstats' u 1:3 w lines lw 1 t 'Quicksort'
